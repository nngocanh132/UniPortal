# UniPortal – environment template. Copy to .env for local use.
# Production values must be injected as real environment variables
# (Railway service variables). Never commit a filled .env file.

# ── Application ───────────────────────────────────────────────
# local | production
APP_ENV=local
# 1 = show PHP errors, 0 = hide (always 0 in production)
APP_DEBUG=0
# Leave empty to auto-detect. XAMPP resolves to /UniPortal/public.
APP_BASE_PATH=
APP_TIMEZONE=Asia/Ho_Chi_Minh

# ── Database ──────────────────────────────────────────────────
# DB_* values are used when no DATABASE_URL/MYSQL_URL is present.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=uniportal
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
# Managed hosts usually expose one of these instead of DB_*:
# DATABASE_URL=mysql://user:pass@host:port/database
# Railway MySQL plugin: MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE

# ── Sessions ──────────────────────────────────────────────────
# 1 forces Secure cookies. Empty = automatic (on when HTTPS is detected).
SESSION_SECURE_COOKIE=

# ── Payment (SePay-compatible) ────────────────────────────────
PAYMENT_PROVIDER=sepay
PAYMENT_BANK_BIN=970436
PAYMENT_BANK_CODE=Vietcombank
PAYMENT_BANK_NAME=Ngân hàng TMCP Ngoại thương Việt Nam
PAYMENT_ACCOUNT_NUMBER=0123456789
PAYMENT_ACCOUNT_HOLDER=UNIVERSITY NAME
PAYMENT_TEST_MODE=0
PAYMENT_TEST_WEBHOOK_KEY=
SEPAY_API_KEY=
SEPAY_WEBHOOK_SECRET=
# apikey | hmac | both
SEPAY_WEBHOOK_AUTH_MODE=apikey
